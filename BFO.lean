/-- [yhb-1] site is a universal -/
def YHB1 : Prop := (Universal Site)
/-- [ylr-1] If something is a fiat-line at any time then as long as it exists it is a fiat-line. -/
def YLR1 : Prop := (∀ (x : Type), ((∃ (t : Type), (InstanceOf x FiatLine t)) → (∀ (t : Type), ((ExistsAt x t) → (InstanceOf x FiatLine t)))))
/-- [yuh-1] If something is a continuant-fiat-boundary at any time then as long as it exists it is a continuant-fiat-boundary. -/
def YUH1 : Prop := (∀ (x : Type), ((∃ (t : Type), (InstanceOf x ContinuantFiatBoundary t)) → (∀ (t : Type), ((ExistsAt x t) → (InstanceOf x ContinuantFiatBoundary t)))))
/-- [zcc-1] immaterial-entity is a universal -/
def ZCC1 : Prop := (Universal ImmaterialEntity)
/-- [zkj-2] one-dimensional-temporal-region, zero-dimensional-temporal-region are mutually disjoint -/
def ZKJ2 : Prop := (¬ (∃ (x t : Type), ((InstanceOf x OneDimensionalTemporalRegion t) ∧ (InstanceOf x ZeroDimensionalTemporalRegion t))))
/-- [zqv-1] process-boundary is a universal -/
def ZQV1 : Prop := (Universal ProcessBoundary)
/-- [zrp-1] relational-quality is a universal -/
def ZRP1 : Prop := (Universal RelationalQuality)
/-- [zuj-1] history is subclass of process -/
def ZUJ1 : Prop := (∀ (t x : Type), ((InstanceOf x History t) → (InstanceOf x Process t)))
/-- [zvi-1] continuant-fiat-boundary is a universal -/
def ZVI1 : Prop := (Universal ContinuantFiatBoundary)
/-- [zwl-1] one-dimensional-spatial-region is a universal -/
def ZWL1 : Prop := (Universal OneDimensionalSpatialRegion)
/-- [zyw-1] generically-dependent-continuant is subclass of continuant -/
def ZYW1 : Prop := (∀ (t x : Type), ((InstanceOf x GenericallyDependentContinuant t) → (InstanceOf x Continuant t)))

