import BfoToLean.Translate
import BfoToLean.Provenance
import Std.Data.HashMap

/-! Deterministic Lean text emission. -/

namespace BfoToLean

open Clif

private def renderRelationSignature (relName : String) (arity : Nat) : String :=
  let args := List.replicate arity "Type"
  let arrowed := String.intercalate " → " (args ++ ["Prop"])
  s!"opaque {relName} : {arrowed}"

/-- Group the translated axioms by canonical owning module. -/
private def groupByModule (axioms : Array LeanAxiom)
    : Array (String × Array LeanAxiom) := Id.run do
  let mut groups : Std.HashMap String (Array LeanAxiom) := {}
  for ax in axioms do
    let cur := groups.getD ax.module #[]
    groups := groups.insert ax.module (cur.push ax)
  let arr := groups.toArray
  let arr := arr.qsort (fun a b => a.1 < b.1)
  return arr.map (fun (m, axs) =>
    (m, axs.qsort (fun a b => a.id < b.id)))

/-- Quote a CLIF gloss safely for embedding in a Lean docstring.
Strips leading/trailing whitespace and replaces any sequence of
`- /` characters that would close the docstring early. -/
private def quoteGloss (s : String) : String :=
  s.trimAscii.toString.replace "-/" "- /"

def emit (prov : Provenance) (vocab : Vocabulary)
         (axioms : Array LeanAxiom) : String := Id.run do
  let mut lines : Array String := #[]
  lines := lines.push (prov.render)
  lines := lines.push ""
  lines := lines.push "/-! Generated by bfo-to-lean. Do not edit by hand. -/"
  lines := lines.push ""
  -- All declarations live under the `BFO` namespace.
  lines := lines.push "namespace BFO"
  lines := lines.push ""
  -- 1. Classifying predicates.
  lines := lines.push "-- Classifying predicates (BFO's three top-level sorts)."
  lines := lines.push "opaque Universal : Type → Prop"
  lines := lines.push "opaque Particular : Type → Prop"
  lines := lines.push "opaque Entity : Type → Prop"
  lines := lines.push ""
  -- 2. Relations sorted by name.
  let relNames := vocab.arity.toArray.qsort (fun a b => a.1 < b.1)
  lines := lines.push "-- BFO relations (instance-of plus the rest, alphabetical)."
  for (n, k) in relNames do
    -- Skip classifiers — emitted above.
    if classifiers.contains n then continue
    lines := lines.push (renderRelationSignature (normalizeVocab n) k)
  lines := lines.push ""
  -- 3. Named universal constants.
  lines := lines.push "-- BFO named universals (opaque constants of Type)."
  for c in vocab.constants do
    lines := lines.push s!"opaque {normalizeVocab c} : Type"
  lines := lines.push ""
  -- 4. Axiom defs, grouped by module, modules alphabetical.
  let grouped := groupByModule axioms
  for (mod, axs) in grouped do
    lines := lines.push s!"-- ── {mod} ──"
    for ax in axs do
      let gloss := quoteGloss ax.gloss
      lines := lines.push s!"/-- [{ax.id}] {gloss} -/"
      lines := lines.push s!"def {ax.defName} : Prop := {ax.body}"
    lines := lines.push ""
  -- 5. Per-module bundles. Each is `BFO.<Module>Bundle` — the `Bundle`
  -- suffix keeps the short `BFO.<Name>` path free for the named universals,
  -- which otherwise collide (e.g. `material-entity` → `BFO.MaterialEntity`).
  for (mod, axs) in grouped do
    lines := lines.push s!"structure {mod}Bundle : Prop where"
    for ax in axs do
      lines := lines.push s!"  {ax.fieldName} : {ax.defName}"
    lines := lines.push ""
  -- 6. Top-level BFO adoption bundle — extends every module bundle, so
  -- every axiom is reachable directly off the bundle (`b.<field>`).
  lines := lines.push "structure BFO : Prop extends"
  let mods := grouped.map (·.1)
  for i in [0:mods.size] do
    let sep := if i + 1 < mods.size then "," else ""
    lines := lines.push s!"  {mods[i]!}Bundle{sep}"
  lines := lines.push ""
  lines := lines.push "end BFO"
  lines := lines.push ""
  return String.intercalate "\n" lines.toList

end BfoToLean
